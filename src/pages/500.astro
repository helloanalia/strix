---
// Error 500 — Figma Strix APP › System › Errores/03-500.
// La tarjeta de "Visitas de la semana" con el gráfico desarmado adentro.
// "Reintentar" le da un golpecito: a veces se acomoda... un ratito.
import PanelShell from "../components/errores/PanelShell.astro";
import { ruta } from "../lib/ruta";

// Estado roto del Figma: alto en px y giro de cada barra.
const barras = [
  { d: "L", h: 56, r: -88, caida: true },
  { d: "M", h: 24, r: 8 },
  { d: "M", h: 20, r: -10 },
  { d: "J", h: 64, r: 4 },
  { d: "V", h: 92, r: 0, curita: true },
  { d: "S", h: 110, r: -12, grieta: true },
  { d: "D", h: 70, r: 9 },
];
---

<PanelShell
  titulo="Error 500 — Error interno del servidor"
  descripcion="Tuvimos un error técnico de nuestro lado. Ya estamos trabajando para solucionarlo."
>
  <article class="tablero p-card" data-reveal="scale">
    <div class="cabeza">
      <p class="p-over">Visitas de la semana</p>
      <span class="badge badge-yellow">Error 500 · Error interno del servidor</span>
    </div>

    <div class="grafico" data-grafico aria-hidden="true">
      <div class="barras" data-barras>
        {barras.map((b) => (
          <div class="col">
            <span class={`barra${b.caida ? " caida" : ""}`}
              style={`--h:${b.h}px; --rot:${b.r}deg`}
              data-h={b.h} data-r={b.r}>
              {b.curita && <span class="curita"></span>}
              {b.grieta && (
                <svg class="grieta" viewBox="0 0 24 40" fill="none"><path d="M12 0 6 12l10 6-8 10 6 12" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
              )}
            </span>
            <span class="dia">{b.d}</span>
          </div>
        ))}
      </div>
      <svg class="llave" viewBox="0 0 24 24" width="44" height="44" fill="none">
        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" stroke="#1e2126" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="chispa c1"></span><span class="chispa c2"></span><span class="chispa c3"></span>
    </div>

    <h1 class="p-title">Se nos desarmó el gráfico.</h1>
    <p class="p-text">Tuvimos un error técnico de nuestro lado. Ya estamos trabajando para solucionarlo rápido y que puedas seguir cruzando datos y conociendo mejor el consumo de tus clientes.</p>

    <div class="pie">
      <div class="p-acciones">
        <a class="btn btn-solid-blue" href={ruta("/")}>Volver al inicio</a>
        <button class="btn btn-white-gray" type="button" data-reintentar>Reintentar</button>
      </div>
      <p class="p-hint" data-pista aria-live="polite">El equipo técnico ya tiene la llave inglesa en la mano.</p>
    </div>
  </article>
</PanelShell>

<style>
  .tablero {
    width: min(720px, 100%);
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 32px;
  }
  .cabeza, .pie { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }

  .grafico {
    position: relative;
    height: 230px;
    border-radius: 12px;
    background:
      linear-gradient(rgb(220 220 220 / .6) 1px, transparent 1px) 24px 40px / calc(100% - 48px) 50px no-repeat,
      linear-gradient(rgb(220 220 220 / .6) 1px, transparent 1px) 24px 90px / calc(100% - 48px) 50px no-repeat,
      linear-gradient(rgb(220 220 220 / .6) 1px, transparent 1px) 24px 140px / calc(100% - 48px) 50px no-repeat,
      rgb(238 241 255 / .5);
    overflow: hidden;
  }
  .grafico.sacude { animation: sacude .4s ease-in-out; }
  @keyframes sacude {
    25% { translate: -5px 2px; }
    50% { translate: 4px -2px; }
    75% { translate: -2px 1px; }
  }

  .barras {
    position: absolute;
    left: 24px; right: 24px;
    top: 0; bottom: 40px;
    display: flex;
    align-items: flex-end;
    border-bottom: 2px solid var(--neutral);
  }
  .col { position: relative; flex: 1; height: 100%; display: flex; justify-content: center; align-items: flex-end; }
  .barra {
    position: relative;
    width: 40px;
    height: var(--h);
    border-radius: 8px 8px 2px 2px;
    background: var(--indigo);
    transform-origin: bottom center;
    rotate: var(--rot);
    transition:
      height .7s cubic-bezier(.34, 1.56, .64, 1),
      rotate .7s cubic-bezier(.34, 1.56, .64, 1),
      translate .7s cubic-bezier(.34, 1.56, .64, 1);
  }
  /* La del lunes se cayó entera y quedó acostada en el piso. */
  .barra.caida { background: var(--light); translate: 20px -20px; }
  .barras.ok .barra { translate: 0 0; background: var(--indigo); }
  .dia {
    position: absolute;
    bottom: -28px;
    font-size: 14px;
    color: var(--muted);
  }

  .curita {
    position: absolute;
    left: 50%; top: 22px;
    width: 56px; height: 20px;
    translate: -50% 0;
    rotate: 24deg;
    border-radius: 10px;
    background: linear-gradient(90deg, #fde68a 32%, #fcd34d 32% 68%, #fde68a 68%);
  }
  .grieta { position: absolute; left: 14px; top: 10px; width: 18px; height: 30px; }
  .barras.ok .curita, .barras.ok .grieta { opacity: 0; transition: opacity .3s; }

  .llave { position: absolute; right: 64px; bottom: 44px; rotate: -20deg; }
  .chispa {
    position: absolute;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 8px 2px rgb(255 199 40 / .7);
  }
  .c1 { left: 76%; top: 36px; }
  .c2 { left: 68%; top: 52px; }
  .c3 { left: 62%; top: 34px; }
  @media (prefers-reduced-motion: no-preference) {
    .chispa { animation: chispa 1.7s steps(1) infinite; }
    .c2 { animation-delay: .6s; animation-duration: 2.1s; }
    .c3 { animation-delay: 1.1s; animation-duration: 2.6s; }
  }
  .barras.ok ~ .chispa { display: none; }
  @keyframes chispa {
    0%, 100% { opacity: 1; }
    10% { opacity: 0; }
    16% { opacity: 1; }
    22% { opacity: 0; }
    40% { opacity: 1; }
  }

  @media (max-width: 640px) {
    .tablero { padding: 24px 20px; }
    .barra { width: 28px; }
    .llave { right: 16px; }
  }
</style>

<script>
  const grafico = document.querySelector<HTMLElement>("[data-grafico]")!;
  const caja = grafico.querySelector<HTMLElement>("[data-barras]")!;
  const barras = [...caja.querySelectorAll<HTMLElement>(".barra")];
  const pista = document.querySelector<HTMLElement>("[data-pista]")!;
  const boton = document.querySelector<HTMLButtonElement>("[data-reintentar]")!;

  const romper = () => {
    caja.classList.remove("ok");
    barras.forEach((b) => {
      b.style.setProperty("--h", `${b.dataset.h}px`);
      b.style.setProperty("--rot", `${b.dataset.r}deg`);
    });
  };
  const arreglar = () => {
    caja.classList.add("ok");
    const alturas = [32, 44, 40, 58, 70, 88, 76];
    barras.forEach((b, i) => {
      b.style.setProperty("--h", `${alturas[i]}%`);
      b.style.setProperty("--rot", "0deg");
    });
  };

  const frases = [
    "Se movió algo. No sabemos si para bien.",
    "Mmm, casi.",
    "Este método no figura en el manual, pero bueno.",
  ];
  let intentos = 0;
  let vuelve: number | undefined;

  boton.addEventListener("click", () => {
    intentos++;
    clearTimeout(vuelve);
    grafico.classList.remove("sacude");
    void grafico.offsetWidth;
    grafico.classList.add("sacude");

    // Cada intento tiene más chances de acomodarlo. Igual dura poco.
    if (Math.random() < Math.min(0.25 + intentos * 0.2, 0.9)) {
      arreglar();
      pista.textContent = "¡Funcionó! ...por ahora.";
      vuelve = window.setTimeout(() => {
        romper();
        pista.textContent = "Y se volvió a desarmar. Se lo dejamos al equipo técnico.";
      }, 2200);
    } else {
      pista.textContent = frases[(intentos - 1) % frases.length];
    }
  });
</script>
