---
// Sin conexión — Figma 376:15752.
// Escenario: una tarjeta de sellos que funciona sin wifi. Se completa tocando
// los casilleros. Arriba, un indicador que avisa en vivo cuando vuelve la red.
import ErrorPage from "../components/ErrorPage.astro";
import { ruta } from "../lib/ruta";

const casilleros = Array.from({ length: 10 }, (_, i) => i + 1);
---

<ErrorPage
  titulo="Sin conexión a la red."
  texto="Parece que te quedaste sin internet. Revisá tu red para seguir viendo tus estadísticas y registrando las visitas de tus clientes en tiempo real."
  icono="wifi"
  badge="Sin conexión"
  boton={null}
>
  <div class="escenario sellos" data-sellos>
    <span class="sl-estado" data-estado>
      <span class="sl-punto"></span>
      <span data-estado-txt>Sin conexión</span>
    </span>

    <div class="sl-tarjeta" data-tarjeta>
      <div class="sl-cabeza">
        <img src={ruta("/img/logo-strix.svg")} alt="" width="62" height="25" />
        <span>Tarjeta offline · <b data-cuenta>0</b>/10</span>
      </div>
      <div class="sl-grilla">
        {casilleros.map((n) => (
          <button class="sl-casillero" type="button" aria-label={`Sellar casillero ${n}`}>
            <span class="sl-num" aria-hidden="true">{n === 10 ? "☕" : n}</span>
            <svg class="sl-sello" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 12.5 4 4 8-9" />
            </svg>
          </button>
        ))}
      </div>
    </div>

    <p class="escenario-msg" data-msg aria-live="polite">Mientras vuelve internet, completá esta tarjeta. Esta sí anda sin wifi.</p>
  </div>

  <a slot="acciones" class="btn btn-ghost-light" href={ruta("/")} data-reintentar>Reintentar</a>
</ErrorPage>

<style>
  .sellos {
    display: grid;
    place-items: center;
    padding-bottom: 40px;
    background:
      radial-gradient(circle at 50% 0%, rgb(84 113 255 / .28), transparent 60%),
      var(--navy);
  }

  .sl-estado {
    position: absolute;
    top: 16px; left: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--r-full);
    background: rgb(220 38 38 / .18);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    color: #fecaca;
    transition: background-color .3s, color .3s;
  }
  .sl-punto { width: 8px; height: 8px; border-radius: 50%; background: var(--red-600); }
  .sl-estado.online { background: rgb(145 210 41 / .3); color: #ecfccb; }
  .sl-estado.online .sl-punto { background: var(--green); }
  @media (prefers-reduced-motion: no-preference) {
    .sl-punto { animation: sl-late 1.4s ease-in-out infinite; }
  }
  @keyframes sl-late { 50% { opacity: .3; } }

  .sl-tarjeta {
    width: min(420px, 100% - 32px);
    padding: 18px 20px 20px;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--indigo), #7d59ff);
    box-shadow: 0 24px 48px rgb(6 2 40 / .45);
    rotate: -2deg;
    transition: rotate .5s var(--ease-rv), scale .5s var(--ease-rv);
  }
  .sl-tarjeta:hover { rotate: 0deg; }
  .sl-tarjeta.completa { animation: sl-festeja .7s var(--ease-rv); }
  @keyframes sl-festeja {
    0% { scale: 1; rotate: -2deg; }
    40% { scale: 1.08; rotate: 3deg; }
    100% { scale: 1; rotate: 0deg; }
  }

  .sl-cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    font-family: var(--font-ui);
    font-size: 12px;
    color: rgb(255 255 255 / .8);
  }
  .sl-cabeza img { width: 62px; height: auto; }

  .sl-grilla {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
  }
  .sl-casillero {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: 0;
    border: 1.5px dashed rgb(255 255 255 / .6);
    border-radius: 50%;
    background: rgb(255 255 255 / .1);
    color: #fff;
    cursor: pointer;
    transition: background-color .2s;
  }
  .sl-casillero:hover { background: rgb(255 255 255 / .2); }
  .sl-num { font-family: var(--font-ui); font-size: 13px; font-weight: 600; opacity: .7; }
  /* El último casillero es el premio. */
  .sl-casillero:last-child .sl-num { font-size: 22px; opacity: 1; }
  .sl-sello {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 22%;
    border-radius: 50%;
    background: #fff;
    color: var(--indigo);
    opacity: 0;
    scale: 1.8;
    rotate: -25deg;
  }
  .sl-casillero.sellado { border-style: solid; border-color: #fff; }
  .sl-casillero.sellado .sl-sello {
    opacity: 1;
    scale: 1;
    rotate: 0deg;
    transition: opacity .15s, scale .35s cubic-bezier(.34, 1.56, .64, 1), rotate .35s var(--ease-rv);
  }

  /* Papel picado al completar. */
  :global(.sl-confeti) {
    position: absolute;
    width: 8px; height: 12px;
    border-radius: 2px;
    pointer-events: none;
    animation: sl-confeti 1.4s cubic-bezier(.2, .7, .4, 1) forwards;
  }
  @keyframes sl-confeti {
    from { opacity: 1; translate: 0 0; rotate: 0deg; }
    to   { opacity: 0; translate: var(--dx) var(--dy); rotate: var(--r); }
  }
</style>

<script>
  const esc = document.querySelector<HTMLElement>("[data-sellos]")!;
  const tarjeta = esc.querySelector<HTMLElement>("[data-tarjeta]")!;
  const cuenta = esc.querySelector<HTMLElement>("[data-cuenta]")!;
  const msg = esc.querySelector<HTMLElement>("[data-msg]")!;
  const casilleros = [...esc.querySelectorAll<HTMLButtonElement>(".sl-casillero")];
  const estado = esc.querySelector<HTMLElement>("[data-estado]")!;
  const estadoTxt = esc.querySelector<HTMLElement>("[data-estado-txt]")!;

  // Reintentar = volver a cargar lo que se estaba viendo antes de caer acá.
  document.querySelector<HTMLAnchorElement>("[data-reintentar]")!.addEventListener("click", (e) => {
    if (history.length > 1) { e.preventDefault(); history.back(); }
  });

  // --- red, en vivo ---
  const pintarRed = () => {
    const on = navigator.onLine;
    estado.classList.toggle("online", on);
    estadoTxt.textContent = on ? "¡Volvió la conexión!" : "Sin conexión";
  };
  window.addEventListener("online", () => {
    pintarRed();
    msg.textContent = "¡Volvió internet! Ya podés reintentar.";
  });
  window.addEventListener("offline", pintarRed);
  pintarRed();

  // --- sellos ---
  const frases = [
    "¡Primer sello! Así empiezan los fans.",
    "Dos. Vas bien.",
    "Tres sellos y ni un mega consumido.",
    "Cuatro. Ya sos cliente frecuente.",
    "La mitad. El router todavía está pensando.",
    "Seis. ¿Probaste apagarlo y prenderlo?",
    "Siete. Ya casi.",
    "Ocho. Se huele el café.",
    "Nueve. Uno más...",
  ];

  const papelPicado = () => {
    const colores = ["#ffc728", "#91d229", "#54ffe0", "#ffffff", "#c0d5ff"];
    const r = tarjeta.getBoundingClientRect();
    const re = esc.getBoundingClientRect();
    for (let i = 0; i < 40; i++) {
      const c = document.createElement("span");
      c.className = "sl-confeti";
      c.style.background = colores[i % colores.length];
      c.style.left = `${r.left - re.left + r.width / 2}px`;
      c.style.top = `${r.top - re.top + r.height / 2}px`;
      c.style.setProperty("--dx", `${(Math.random() - 0.5) * 520}px`);
      c.style.setProperty("--dy", `${(Math.random() - 0.7) * 320}px`);
      c.style.setProperty("--r", `${Math.random() * 720 - 360}deg`);
      esc.append(c);
      c.addEventListener("animationend", () => c.remove());
    }
  };

  let reinicio: number | undefined;
  casilleros.forEach((b) => b.addEventListener("click", () => {
    // Se sella siempre el próximo libre, toques el que toques: como en la vida real.
    const libre = casilleros.find((c) => !c.classList.contains("sellado"));
    if (!libre) return;
    libre.classList.add("sellado");
    const n = casilleros.filter((c) => c.classList.contains("sellado")).length;
    cuenta.textContent = String(n);

    if (n < 10) {
      msg.textContent = frases[n - 1];
      return;
    }
    msg.textContent = "¡Tarjeta completa! Te ganaste un café (imaginario, sin wifi no podemos más).";
    tarjeta.classList.add("completa");
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) papelPicado();
    clearTimeout(reinicio);
    reinicio = window.setTimeout(() => {
      casilleros.forEach((c) => c.classList.remove("sellado"));
      tarjeta.classList.remove("completa");
      cuenta.textContent = "0";
      msg.textContent = "Tarjeta nueva. Si internet sigue sin volver, ya sabés qué hacer.";
    }, 3500);
  }));
</script>
