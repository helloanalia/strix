---
// Error 403 — Figma 376:15764.
// Escenario: un candado que se puede intentar abrir a los golpes. No abre.
import ErrorPage from "../components/ErrorPage.astro";
---

<ErrorPage
  titulo="Error 403 — Acceso denegado / Contenido restringido."
  texto="Tu usuario no tiene los permisos necesarios para ver estas configuraciones o analíticas. Pedile al administrador de tu negocio que revise tus niveles de acceso."
  icono="candado"
  badge="Acceso denegado"
>
  <div class="escenario candado" data-candado>
    <span class="cd-codigo display" aria-hidden="true">403</span>

    <button class="cd-lock" type="button" data-lock aria-label="Intentar abrir el candado">
      <svg viewBox="0 0 120 150" width="120" height="150" aria-hidden="true">
        <path class="cd-arco" d="M30 70V45a30 30 0 0 1 60 0v25" fill="none" stroke="#c0d5ff" stroke-width="12" stroke-linecap="round" />
        <rect x="10" y="66" width="100" height="78" rx="16" fill="#5471ff" />
        <rect x="10" y="66" width="100" height="78" rx="16" fill="none" stroke="rgb(255 255 255 / .35)" stroke-width="2" />
        <circle cx="60" cy="98" r="10" fill="#16076a" />
        <path d="M55 104h10l-2 18h-6Z" fill="#16076a" />
      </svg>
    </button>

    <span class="cd-intentos" data-intentos aria-hidden="true"></span>
    <p class="escenario-msg" data-msg aria-live="polite">Tocá el candado. Capaz que hoy abre.</p>
  </div>
</ErrorPage>

<style>
  .candado {
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(-45deg, rgb(255 255 255 / .03) 0 18px, transparent 18px 36px),
      var(--navy);
  }
  .cd-codigo {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: clamp(120px, 26vw, 230px);
    color: transparent;
    -webkit-text-stroke: 2px rgb(255 255 255 / .14);
    pointer-events: none;
  }

  .cd-lock {
    position: relative;
    padding: 0;
    margin-top: -36px;
    border: 0;
    background: none;
    cursor: pointer;
    filter: drop-shadow(0 18px 30px rgb(6 2 40 / .5));
    transition: scale .2s var(--ease-rv);
  }
  .cd-lock:hover { scale: 1.05; }
  .cd-lock:active { scale: .96; }
  .cd-lock svg { width: clamp(90px, 16vw, 120px); height: auto; overflow: visible; }
  .cd-arco { transform-origin: 30px 70px; }

  .cd-lock.sacude { animation: cd-sacude .45s ease-in-out; }
  .cd-lock.sacude .cd-arco { animation: cd-arco .45s ease-in-out; }
  @keyframes cd-sacude {
    0%, 100% { rotate: 0deg; }
    20% { rotate: -9deg; }
    40% { rotate: 8deg; }
    60% { rotate: -5deg; }
    80% { rotate: 3deg; }
  }
  /* El arco sube un poquito... y vuelve a bajar. */
  @keyframes cd-arco {
    0%, 100% { translate: 0 0; }
    35% { translate: 0 -9px; }
    55% { translate: 0 0; }
  }

  .cd-intentos {
    position: absolute;
    top: 16px; right: 18px;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    color: rgb(255 255 255 / .6);
  }

  /* Estrellitas de "¡clonk!" al golpear. */
  :global(.cd-chispa) {
    position: absolute;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #ffc728;
    pointer-events: none;
    animation: cd-chispa .6s var(--ease-rv) forwards;
  }
  @keyframes cd-chispa {
    from { opacity: 1; translate: 0 0; scale: 1; }
    to   { opacity: 0; translate: var(--dx) var(--dy); scale: .3; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cd-lock.sacude, .cd-lock.sacude .cd-arco { animation: none; }
  }
</style>

<script>
  const esc = document.querySelector<HTMLElement>("[data-candado]")!;
  const lock = esc.querySelector<HTMLButtonElement>("[data-lock]")!;
  const msg = esc.querySelector<HTMLElement>("[data-msg]")!;
  const contador = esc.querySelector<HTMLElement>("[data-intentos]")!;

  const frases = [
    "Nop. Sigue cerrado.",
    "Probaste con más fuerza. Sigue cerrado.",
    "Ni con sellos dobles abre.",
    "Este candado no se deja convencer.",
    "¿Y si probás con el admin de tu negocio?",
    "En serio: la llave la tiene tu admin.",
    "El candado te pide que dejes de tocarlo.",
  ];
  let n = 0;

  lock.addEventListener("click", () => {
    n++;
    msg.textContent = frases[Math.min(n - 1, frases.length - 1)];
    contador.textContent = `Intentos: ${n}`;

    lock.classList.remove("sacude");
    void lock.offsetWidth;   // reinicia la animación
    lock.classList.add("sacude");

    // Chispas desde el centro del candado.
    const r = lock.getBoundingClientRect();
    const re = esc.getBoundingClientRect();
    const cx = r.left - re.left + r.width / 2;
    const cy = r.top - re.top + r.height * 0.6;
    for (let i = 0; i < 7; i++) {
      const s = document.createElement("span");
      s.className = "cd-chispa";
      const a = Math.random() * Math.PI * 2;
      const d = 50 + Math.random() * 50;
      s.style.left = `${cx}px`;
      s.style.top = `${cy}px`;
      s.style.setProperty("--dx", `${Math.cos(a) * d}px`);
      s.style.setProperty("--dy", `${Math.sin(a) * d}px`);
      esc.append(s);
      s.addEventListener("animationend", () => s.remove());
    }
  });
</script>
