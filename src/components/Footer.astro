---
const columnas = [
  {
    titulo: "Explora",
    links: [
      { texto: "Cómo funciona", href: "#como-funciona" },
      { texto: "Canales", href: "#herramientas" },
      { texto: "Industrias", href: "#industrias" },
      { texto: "FAQ", href: "#contacto" },
    ],
  },
  {
    titulo: "Legal",
    links: [
      { texto: "Términos y Condiciones", href: "#" },
      { texto: "Política de Privacidad", href: "#" },
    ],
  },
  {
    titulo: "Contacto",
    links: [{ texto: "info@strix.fan", href: "mailto:info@strix.fan" }],
  },
];
---

<footer class="footer" data-reveal="fade">
  <div class="container footer-inner">
    <div class="marca">
      <p class="wordmark">stri<span>x</span></p>
      <p class="tagline">
        Los negocios que crecen<br />convierten clientes en <span>Fans</span>
      </p>
    </div>

    <nav class="cols" aria-label="Pie de página">
      {
        columnas.map((c) => (
          <div class="col">
            <h2>{c.titulo}</h2>
            <ul>
              {c.links.map((l) => (
                <li>
                  <a href={l.href}>{l.texto}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="container barra">
    <p class="legal">Hecho en Uruguay — © 2026 Strix App. Todos los derechos reservados.</p>
    <ul class="redes">
      <li>
        <a href="https://instagram.com/" aria-label="Instagram de strix">
          <svg viewBox="0 0 40 40" width="34" height="34" role="img" aria-hidden="true">
            <defs>
              <radialGradient id="ig" cx="30%" cy="105%" r="130%">
                <stop offset="0%" stop-color="#FFD776" />
                <stop offset="35%" stop-color="#F3543C" />
                <stop offset="70%" stop-color="#D42E92" />
                <stop offset="100%" stop-color="#6B33D6" />
              </radialGradient>
            </defs>
            <rect width="40" height="40" rx="11" fill="url(#ig)" />
            <rect x="10.5" y="10.5" width="19" height="19" rx="6" fill="none" stroke="#fff" stroke-width="2.4" />
            <circle cx="20" cy="20" r="4.8" fill="none" stroke="#fff" stroke-width="2.4" />
            <circle cx="26.3" cy="13.8" r="1.5" fill="#fff" />
          </svg>
        </a>
      </li>
      <li>
        <a href="https://wa.me/" aria-label="WhatsApp de strix">
          <svg viewBox="0 0 40 40" width="34" height="34" role="img" aria-hidden="true">
            <rect width="40" height="40" rx="11" fill="#25D366" />
            <path
              d="M27.3 22.6c-.4-.2-2.3-1.1-2.6-1.2-.3-.1-.6-.2-.8.2-.2.4-.9 1.2-1.1 1.4-.2.2-.4.3-.8.1-.4-.2-1.6-.6-3.1-1.9-1.1-1-1.9-2.3-2.1-2.7-.2-.4 0-.6.2-.8.2-.2.4-.4.6-.7.2-.2.2-.4.3-.7.1-.3 0-.5 0-.7 0-.2-.8-1.9-1-2.6-.3-.7-.6-.6-.8-.6h-.7c-.2 0-.6.1-1 .5-.3.4-1.3 1.3-1.3 3.1s1.3 3.6 1.5 3.9c.2.2 2.6 4 6.4 5.6 2.2.9 3.1 1 4.2.9.7-.1 2.3-.9 2.6-1.8.3-.9.3-1.7.2-1.8-.1-.2-.3-.3-.7-.5Z"
              fill="#fff" />
            <path
              d="M20.1 9.3c-5.9 0-10.7 4.8-10.7 10.7 0 1.9.5 3.7 1.4 5.3L9.3 30.7l5.6-1.5c1.5.8 3.3 1.3 5.2 1.3 5.9 0 10.7-4.8 10.7-10.7S26 9.3 20.1 9.3Z"
              fill="none" stroke="#fff" stroke-width="2" />
          </svg>
        </a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: 72px 32px;
    background:
      radial-gradient(58% 92% at 50% 118%, rgb(84 255 224 / .5), transparent 62%),
      var(--indigo);
    color: #fff;
    overflow: hidden;
  }

  .footer-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 64px;
    align-items: start;
  }

  .wordmark {
    margin: 0;
    font-size: clamp(72px, 9vw, 128px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.055em;
    color: #fff;
  }
  .wordmark span { color: var(--indigo-light); }

  .tagline {
    margin: 16px 0 0;
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 700;
    line-height: 1.24;
    letter-spacing: 0.15px;
  }
  .tagline span { color: rgb(255 255 255 / .55); }

  .cols { display: grid; grid-template-columns: repeat(3, auto); gap: 64px; padding-top: 12px; }
  .col h2 { margin: 0 0 24px; font-size: 18px; font-weight: 700; }
  .col ul { display: grid; gap: 20px; margin: 0; padding: 0; list-style: none; }
  .col a {
    font-family: var(--font-ui);
    font-size: 14px;
    color: rgb(255 255 255 / .88);
    transition: color .15s ease;
  }
  .col a:hover { color: #fff; text-decoration: underline; }

  .barra {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 96px;
  }
  .legal { margin: 0; font-size: 12px; color: rgb(255 255 255 / .72); }
  .redes { display: flex; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .redes a { display: block; border-radius: 11px; }

  @media (max-width: 900px) {
    .footer { padding-top: 56px; }
    .footer-inner { grid-template-columns: 1fr; gap: 44px; }
    .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; padding-top: 0; }
    .barra { margin-top: 56px; flex-direction: column; align-items: flex-start; gap: 20px; }
  }
  @media (max-width: 560px) {
    .cols { grid-template-columns: 1fr; gap: 28px; }
    .col h2 { margin-bottom: 16px; }
    .col ul { gap: 14px; }
  }
</style>
