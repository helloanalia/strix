---
import { ruta } from "../lib/ruta";
// "Empresas que confían en nosotros" — logos dispuestos alrededor del sticker.
// Posiciones en % sobre el ancho de referencia del Figma (1440px).
import StickerPeel from "./StickerPeel.astro";

/* El nombre no siempre es lo que dice el logo: Capriccio es "Capriccio
   Helados", y de Café Suárez sólo va el nombre, sin el resto de la leyenda que
   trae la imagen. Es el texto que aparece al pasar por encima y también el alt
   de cada logo, así que los dos dicen lo mismo.

   `rubro` es la segunda línea del tooltip. Está deducido del propio nombre de
   cada marca, no es información que me hayan dado: conviene confirmarlo con
   cada cliente antes de dejarlo así en un sitio público. */
const logos = [
  { src: ruta("/img/clientes/esquina-cantina.webp"), nombre: "Esquina Cantina",   rubro: "Cantina",    clase: "l1", desde: "left" },
  { src: ruta("/img/clientes/capriccio.webp"),       nombre: "Capriccio Helados", rubro: "Heladería",  clase: "l2", desde: "right" },
  { src: ruta("/img/clientes/cliente-3.webp"),       nombre: "Club Café",         rubro: "Cafetería",  clase: "l3", desde: "left" },
  { src: ruta("/img/clientes/cafe-suarez.webp"),     nombre: "Café Suárez",       rubro: "Cafetería",  clase: "l4", desde: "right" },
];
---

<section class="clientes">
  <div class="container">
    <h2 class="section-title" data-reveal="up">
      <span class="line">Empresas que</span>
      <span class="line accent">confían en nosotros</span>
    </h2>

    <div class="escena">
      <span class="sticker">
        <!-- Este no se despega con el scroll: está quieto, con la punta
             derecha apenas levantada. -->
        <StickerPeel src={ruta("/img/sticker-strix.webp")} width={1400} height={513} alt="strix"
          giro="-4deg" modo="punta" angulo={22} corte={12} aplanado={0.5} fijo={1} />
      </span>
      {
        logos.map((l, i) => (
          <span
            class={`logo ${l.clase}`}
            data-reveal={l.desde}
            style={`--rv-delay:${i * 0.12}s`}
          >
            <img src={l.src} alt={`${l.nombre} — ${l.rubro}`} loading="lazy" />
            {/* Duplica al alt, así que para un lector de pantalla se oculta. */}
            <span class="logo-tip" aria-hidden="true">
              <span class="logo-tip-nombre">{l.nombre}</span>
              <span class="logo-tip-rubro">{l.rubro}</span>
            </span>
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .clientes { position: relative; background: #fff; padding-block: 88px 64px; }

  .escena { position: relative; margin-top: 24px; aspect-ratio: 1280 / 700; }

  .sticker {
    display: block;
    position: absolute;
    left: 50%; top: 50%;
    width: 29.5%;  /* la mitad del tamaño anterior */
    transform: translate(-50%, -50%);
  }

  /* El logo pasó a ser un envoltorio con la imagen y el nombre adentro. Cada
     nivel se queda con un canal de transformación, que son de un solo valor:
     el envoltorio lleva la entrada (`translate`/`scale` del data-reveal) y el
     flote (`transform`); la imagen, el levantarse al pasar por encima. Si el
     hover viviera en el envoltorio le pisaría el `translate` a la entrada. */
  .logo { position: absolute; display: block; }
  .logo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 50%;
    box-shadow: 0 6px 20px rgb(31 41 55 / .08);
    transition: translate .35s var(--ease-rv), scale .35s var(--ease-rv),
      box-shadow .35s var(--ease-rv);
  }

  /* --- tooltip ---
     Mismo diseño y misma animación que el componente de referencia, hecho con
     las herramientas que ya usa el sitio.

     Va todo en las propiedades sueltas `translate` / `rotate` / `scale` y no en
     `transform`: así el centrado, la entrada y el seguimiento del puntero se
     componen sin pisarse, que es lo que en el original resuelven tres motion
     values distintos. */
  .logo-tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 14px);
    z-index: 50;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 8px 16px;
    border-radius: var(--r-md, 8px);
    background: var(--dark);
    box-shadow: 0 20px 25px -5px rgb(15 18 30 / .3), 0 8px 10px -6px rgb(15 18 30 / .3);
    font-family: var(--font-ui);
    line-height: 1.25;
    white-space: nowrap;
    pointer-events: none;

    /* Estado cerrado: abajo, chico y transparente. */
    translate: calc(-50% + var(--tip-x, 0px)) 20px;
    scale: .6;
    rotate: var(--tip-giro, 0deg);
    opacity: 0;

    /* La entrada del original es un resorte (stiffness 260, damping 10): llega
       de abajo y se pasa un poco de largo antes de asentarse. Esa curva es lo
       más parecido en CSS. El seguimiento del puntero es más lento y más
       blando, como el segundo resorte (stiffness 100, damping 5). */
    transition:
      opacity .18s ease-out,
      scale .32s cubic-bezier(.34, 1.56, .64, 1),
      translate .42s cubic-bezier(.22, 1.4, .36, 1),
      rotate .42s cubic-bezier(.22, 1.4, .36, 1);
  }
  .logo:hover .logo-tip {
    opacity: 1;
    scale: 1;
    translate: calc(-50% + var(--tip-x, 0px)) 0;
  }

  /* Los dos hilos de color del borde inferior, que es lo que le da el detalle:
     uno corto y otro más largo, cada uno apagándose hacia las puntas. */
  .logo-tip::before,
  .logo-tip::after {
    content: "";
    position: absolute;
    bottom: -1px;
    height: 1px;
  }
  .logo-tip::before {
    left: 40px;
    width: 20%;
    background: linear-gradient(to right, transparent, #10b981, transparent);
  }
  .logo-tip::after {
    left: 40px;
    width: 40%;
    background: linear-gradient(to right, transparent, #0ea5e9, transparent);
  }

  .logo-tip-nombre {
    position: relative;
    z-index: 30;
    font-size: 16px;
    font-weight: 700;
    color: var(--page);
  }
  .logo-tip-rubro {
    font-size: 12px;
    color: rgb(255 255 255 / .5);
  }

  @media (prefers-reduced-motion: no-preference) {
    .logo:hover img {
      translate: 0 -12px;
      scale: 1.07;
      box-shadow: 0 18px 34px rgb(31 41 55 / .18);
    }

    /* El flote va en `transform` y no en `translate` a propósito: `translate`
       ya lo usan la entrada (data-reveal) y el hover, y una animación le gana
       a las dos, así que el logo no entraría ni se levantaría al señalarlo.
       `transform` está libre y se compone con ellas sin pisarlas. */
    .logo { animation: flotar var(--flota-dur, 8s) ease-in-out var(--flota-fase, 0s) infinite; }
  }

  /* Ida y vuelta por distinto camino: un sube-y-baja simple se lee como un
     resorte, no como algo flotando. */
  @keyframes flotar {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    33% {
      transform: translate(3px, calc(var(--flota-y, 10px) * -1))
                 rotate(var(--flota-rot, 1.6deg));
    }
    66% {
      transform: translate(-3px, calc(var(--flota-y, 10px) * -0.4))
                 rotate(calc(var(--flota-rot, 1.6deg) * -0.7));
    }
  }

  /* Cada uno con su período, su fase y su amplitud: con los cuatro iguales
     parecen colgados de la misma barra. */
  .l1 { left: 3.9%;  top: 16.4%; width: 15.2%; --flota-dur: 7.5s; --flota-fase: -0.8s; --flota-y: 11px; }
  .l2 { left: 67.6%; top: 2.9%;  width: 14.1%; --flota-dur: 9.2s; --flota-fase: -3.4s; --flota-y: 8px;  --flota-rot: 1.2deg; }
  .l3 { left: 26.6%; top: 71.4%; width: 12.5%; --flota-dur: 6.4s; --flota-fase: -5.1s; --flota-y: 13px; --flota-rot: 2deg; }
  .l4 { left: 70.7%; top: 65.7%; width: 13.3%; --flota-dur: 8.6s; --flota-fase: -2.2s; --flota-y: 9px;  --flota-rot: 1.4deg; }

  @media (max-width: 720px) {
    .clientes { padding-block: 56px 40px; }
    .escena {
      aspect-ratio: auto;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 28px;
      margin-top: 36px;
    }
    .sticker { position: static; width: min(52%, 190px); transform: none; flex-basis: 100%; margin-inline: auto; }
    /* `relative` y no `static`: el nombre va posicionado contra el logo. */
    .logo { position: relative; width: 96px; }
  }
</style>

<script>
  /* El tooltip sigue al puntero: se inclina y se corre según de qué lado del
     logo esté el mouse. En el componente de referencia esto son dos motion
     values de framer-motion; acá son dos variables CSS y la transición de
     arriba hace de resorte.

     El rango es el mismo del original: ±100px de distancia al centro se
     mapean a ±45° de giro y ±50px de corrimiento. */
  const TOPE = 100, GIRO = 45, CORRIMIENTO = 50;

  document.querySelectorAll<HTMLElement>(".logo").forEach((logo) => {
    const tip = logo.querySelector<HTMLElement>(".logo-tip");
    if (!tip) return;

    logo.addEventListener("mousemove", (e) => {
      const caja = logo.getBoundingClientRect();
      const desdeElCentro = e.clientX - caja.left - caja.width / 2;
      const f = Math.max(-1, Math.min(1, desdeElCentro / TOPE));
      tip.style.setProperty("--tip-giro", `${(f * GIRO).toFixed(2)}deg`);
      tip.style.setProperty("--tip-x", `${(f * CORRIMIENTO).toFixed(2)}px`);
    });

    // Al salir vuelve a cero, así la próxima vez entra derecho.
    logo.addEventListener("mouseleave", () => {
      tip.style.setProperty("--tip-giro", "0deg");
      tip.style.setProperty("--tip-x", "0px");
    });
  });
</script>
