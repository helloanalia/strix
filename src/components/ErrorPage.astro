---
/**
 * Página de error / estado del sistema.
 * La tarjeta replica las del Figma "Strix APP" → System → Merchant
 * (node 376:15732): fondo blue/500, Montserrat, botón outline blanco e ícono
 * en un círculo punteado con su badge oscuro.
 *
 * Arriba de la tarjeta va el "escenario": un slot con algo para tocar
 * mientras tanto. Cada página trae el suyo.
 */
import Layout from "../layouts/Layout.astro";
import { ruta } from "../lib/ruta";

type Icono = "grafico" | "candado" | "prohibido" | "wifi" | "tienda" | "logo";

interface Props {
  titulo: string;
  texto: string;
  icono: Icono;
  badge?: string;
  /** `null` para no mostrar botón (el Figma de "Sin conexión" no lleva). */
  boton?: { texto: string; href: string } | null;
}

const {
  titulo,
  texto,
  icono,
  badge,
  boton = { texto: "Volver al inicio", href: ruta("/") },
} = Astro.props;
---

<Layout title={`${titulo.replace(/\.$/, "")} — strix`} description={texto}>
  <main class="err">
    <div class="err-glows" aria-hidden="true">
      <img class="glow glow-bar" src={ruta("/decor/vector4.svg")} alt="" />
      <img class="glow glow-blob" src={ruta("/decor/ellipse139.svg")} alt="" />
    </div>

    <header class="err-nav container" data-reveal="fade" style="--rv-dur:.5s">
      <a href={ruta("/")} aria-label="strix — inicio">
        <img src={ruta("/img/logo-strix.svg")} alt="strix" width="123" height="49" />
      </a>
    </header>

    <div class="err-escena">
      <div class="err-juego" data-reveal="scale" style="--rv-delay:.05s">
        <slot />
      </div>

      <article class="err-card" data-reveal="up-md" style="--rv-delay:.15s">
        <div class="err-copy">
          <h1>{titulo}</h1>
          <p>{texto}</p>
          <div class="err-acciones">
            <slot name="acciones">
              {boton && <a class="btn btn-ghost-light" href={boton.href}>{boton.texto}</a>}
            </slot>
          </div>
        </div>

        {icono === "logo" ? (
          <img class="err-logo" src={ruta("/img/logo-strix.svg")} alt="" width="123" height="49" />
        ) : (
          <div class="err-icono" aria-hidden="true">
            <span class="err-circulo">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor"
                stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                {icono === "grafico" && (
                  <>
                    <path d="M3 3v16a2 2 0 0 0 2 2h16" />
                    <path d="m7 15 4-4 3 3 5-6" />
                  </>
                )}
                {icono === "candado" && (
                  <>
                    <rect x="4" y="11" width="16" height="10" rx="2" />
                    <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                    <circle cx="12" cy="16" r="1" />
                  </>
                )}
                {icono === "prohibido" && (
                  <>
                    <circle cx="12" cy="12" r="9" />
                    <path d="m5.6 5.6 12.8 12.8" />
                  </>
                )}
                {icono === "wifi" && (
                  <>
                    <path d="M12 20h.01" />
                    <path d="M8.5 16.4a5 5 0 0 1 7 0" />
                    <path d="M5 12.9a10 10 0 0 1 5.2-2.8" />
                    <path d="M19 12.9a10 10 0 0 0-2.1-1.6" />
                    <path d="M2 8.8a15 15 0 0 1 4.2-2.6" />
                    <path d="M22 8.8A15 15 0 0 0 10.7 5" />
                    <path d="m2 2 20 20" />
                  </>
                )}
                {icono === "tienda" && (
                  <>
                    <path d="M4 10v10h16V10" />
                    <path d="M3 10 5 4h14l2 6" />
                    <path d="M3 10a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0" />
                    <path d="M10 20v-5h4v5" />
                  </>
                )}
              </svg>
            </span>
            {badge && <span class="err-badge">{badge}</span>}
          </div>
        )}
      </article>
    </div>
  </main>
</Layout>

<style>
  .err {
    /* blue/500 de la tarjeta del Figma. No está entre los tokens de la
       landing porque ahí no se usa. */
    --card-blue: #6284ff;

    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background: var(--deep);
    color: #fff;
    isolation: isolate;
    overflow: hidden;
  }

  /* Mismos glows que el hero de la landing. */
  .err-glows { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: -1; }
  .glow { position: absolute; max-width: none; }
  .glow-bar { left: -20%; top: -18vw; width: 140%; }
  .glow-blob {
    left: 50%; top: 52%;
    width: 110%;
    transform: translateX(-50%) rotate(15deg);
    opacity: .85;
  }
  @media (prefers-reduced-motion: no-preference) {
    .glow-bar  { animation: err-bar 29s ease-in-out infinite; }
    .glow-blob { animation: err-blob 24s ease-in-out -6s infinite; }
  }
  @keyframes err-bar {
    0%, 100% { translate: 0 0; opacity: 1; }
    50%      { translate: 2.5% -1.2%; opacity: .8; }
  }
  @keyframes err-blob {
    0%, 100% { transform: translateX(-50%) rotate(15deg); scale: 1; }
    50%      { transform: translateX(-53%) rotate(10deg); scale: 1.08; }
  }

  .err-nav { padding-block: 29px 8px; }
  .err-nav img { width: 123px; height: auto; }

  .err-escena {
    flex: 1;
    width: min(800px, 100% - var(--gutter) * 2);
    margin-inline: auto;
    padding-block: 24px 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
  }

  .err-juego { position: relative; }

  /* Base común de los escenarios de cada página. */
  .err-juego :global(.escenario) {
    position: relative;
    height: clamp(260px, 42vw, 340px);
    border-radius: var(--r-3xl);
    background: rgb(255 255 255 / .04);
    border: 1px solid rgb(255 255 255 / .12);
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
  }
  /* Línea de texto que comenta lo que va pasando en el escenario. */
  .err-juego :global(.escenario-msg) {
    position: absolute;
    left: 50%; bottom: 18px;
    translate: -50% 0;
    width: max-content;
    max-width: calc(100% - 32px);
    margin: 0;
    padding: 8px 14px;
    border-radius: var(--r-full);
    background: rgb(17 24 39 / .72);
    backdrop-filter: blur(6px);
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 500;
    line-height: 18px;
    text-align: center;
    color: #fff;
    pointer-events: none;
  }

  /* --- tarjeta (Figma 376:15764) --- */
  .err-card {
    display: flex;
    align-items: center;
    gap: 36px;
    padding: 24px;
    border-radius: 12.5px;
    background: var(--card-blue);
    box-shadow:
      0 20px 25px -5px rgb(0 0 0 / .1),
      0 8px 10px -6px rgb(0 0 0 / .1);
    font-family: var(--font-alt);
  }
  .err-copy {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12.5px;
  }
  .err-copy h1 {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.12px;
    text-wrap: balance;
  }
  .err-copy p {
    margin: 0;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0.08px;
    text-wrap: pretty;
  }
  .err-acciones { display: flex; flex-wrap: wrap; gap: 12px; }
  .err-acciones:empty { display: none; }

  .err-icono {
    flex: none;
    display: grid;
    justify-items: center;
  }
  .err-circulo {
    display: grid;
    place-items: center;
    width: 70px;
    height: 70px;
    border-radius: 50%;
    border: 1.5px dashed rgb(255 255 255 / .7);
    background: rgb(255 255 255 / .1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .err-circulo { animation: err-gira 18s linear infinite; }
    .err-circulo svg { animation: err-gira 18s linear infinite reverse; }
  }
  @keyframes err-gira { to { rotate: 360deg; } }

  .err-badge {
    position: relative;
    margin-top: -14px;
    padding: 6px 10px;
    border-radius: 6px;
    background: #111827;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 0.06px;
    white-space: nowrap;
  }
  .err-logo { flex: none; width: 123px; height: auto; }

  @media (max-width: 640px) {
    .err-card { flex-direction: column-reverse; align-items: flex-start; gap: 20px; }
    .err-copy h1 { font-size: 21px; }
  }
</style>
